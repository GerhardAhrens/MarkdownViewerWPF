<UserControl
    x:Class="System.Windows.Documents.MarkdownEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Documents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Margin="5"
        BorderBrush="Gray"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Line Numbers  -->
                <Canvas
                    x:Name="LineNumberCanvas"
                    Grid.Column="0"
                    Background="#F5F5F5"
                    ClipToBounds="True" />

                <!--  Text Editor  -->
                <!--  Current Line Highlight  -->
                <Rectangle
                    x:Name="CurrentLineHighlight"
                    Height="20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Fill="#20A0C5FF"
                    IsHitTestVisible="False" />

                <TextBox
                    x:Name="Editor"
                    Grid.Column="1"
                    Padding="3"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    FontFamily="Consolas"
                    FontSize="14"
                    HorizontalScrollBarVisibility="Auto"
                    Loaded="Editor_Loaded"
                    SelectionChanged="Editor_SelectionChanged"
                    TextChanged="Editor_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!--  StatusBar  -->
            <StatusBar Grid.Row="1">
                <StatusBarItem>
                    <TextBlock Text="  " />
                </StatusBarItem>

                <StatusBarItem>
                    <TextBlock x:Name="StatusCursor" />
                </StatusBarItem>

                <Separator />

                <StatusBarItem>
                    <TextBlock x:Name="StatusLines" />
                </StatusBarItem>

                <Separator />

                <StatusBarItem>
                    <TextBlock x:Name="StatusSelection" />
                </StatusBarItem>

                <Separator />

                <StatusBarItem>
                    <TextBlock x:Name="StatusUtf" />
                </StatusBarItem>

            </StatusBar>
        </Grid>
    </Border>
</UserControl>
